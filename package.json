{
  "name": "bite-buddy",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "data:build": "tsx scripts/build-data.ts",
    "data:check": "tsx scripts/check-data.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "food:check": "tsx scripts/audit-foods.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run data:check && npm run text:check && npm run db:check && npm run build",
    "build:single": "npm run build && tsx scripts/build-single.ts",
    "test:single": "npm run build:single && node scripts/check-single.mjs",
    "text:check": "tsx scripts/check-text.ts",
    "db:check": "tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
